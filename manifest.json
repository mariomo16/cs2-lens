{
  "manifest_version": 3,
  "name": "CS2 Vision",
  "description": "View CS2 stats on Steam: K/D, HLTV rating, winrate, total matches and much more. Includes Faceit and Leetify data.",
  "version": "0.3.0",
  "icons": {
    "16": "public/assets/icons/icon512.png",
    "48": "public/assets/icons/icon512.png",
    "128": "public/assets/icons/icon512.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "permissions": [],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://csstats.gg/*",
    "https://cs2-lens-proxy.vercel.app/*",
    "https://api-public.cs-prod.leetify.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/id/*",
        "https://steamcommunity.com/profiles/*"
      ],
      "js": ["dist/content.js"],
      "css": ["src/content/content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/fonts/*.woff2",
        "public/assets/premier/*.svg",
        "public/assets/faceit/*.svg",
        "public/assets/ui/clipboard-document.svg",
        "public/assets/ui/check.svg",
        "public/assets/ui/exclamation-triangle.svg"
      ],
      "matches": ["https://steamcommunity.com/*"]
    }
  ]
}
