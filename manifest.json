{
	"manifest_version": 3,
	"name": "CS2 Lens",
	"description": "Chrome extension for CS2 stats and inventory value on Steam profiles",
	"version": "0.3.0",
	"icons": {
		"16": "assets/icons/icon512.png",
		"48": "assets/icons/icon512.png",
		"128": "assets/icons/icon512.png"
	},
	"permissions": [],
	"background": {
		"service_worker": "dist/background.js",
		"type": "module"
	},
	"host_permissions": [
		"https://csstats.gg/*",
		"https://faceitstats.gg/*",
		"https://api.skinport.com/*"
	],
	"content_scripts": [
		{
			"matches": [
				"https://steamcommunity.com/id/*",
				"https://steamcommunity.com/profiles/*"
			],
			"js": ["dist/content.js"],
			"css": ["style.css"],
			"run_at": "document_end"
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"assets/fonts/*.woff2",
				"assets/premier/*.svg",
				"assets/faceit/*.svg"
			],
			"matches": ["https://steamcommunity.com/*"]
		}
	]
}
